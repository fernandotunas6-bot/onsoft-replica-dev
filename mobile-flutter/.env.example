# Configuração do SIGA Plus Flutter (copiar para .env; o .env não vai para o Git).
# Compilar com: flutter build apk --release --dart-define-from-file=.env
#
# ATENÇÃO: estes valores ficam DENTRO do APK e qualquer pessoa os pode ler.
# Só valores públicos. Nunca colocar aqui: senha da base de dados, chave
# service_role / sb_secret_, senha do Gmail/SMTP, chaves privadas ou tokens.
# Esses segredos ficam no servidor (segredos do Supabase / Cloudflare).
# `node scripts/check-env.mjs .env` recusa o ficheiro se encontrar algum.

# Supabase do SGA (os mesmos valores públicos do portal web).
SUPABASE_URL=https://xodgfmxiaunpamctfeea.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_NSqtGz5zxP_EngLuNj00Og_y3V4D4td

# API móvel (/api/mobile-v4) servida pelo domínio da app.
SIGA_API_ORIGIN=https://m.portal-siga.com

# Entrar com Google (Gmail/Google Workspace), Microsoft e Apple. Só ligar
# depois de, no Supabase → Authentication → Providers, activar o fornecedor
# (Google, Azure, Apple) e acrescentar SIGA_AUTH_REDIRECT às «Redirect URLs».
# Desligados, os botões continuam no ecrã e explicam que ainda não estão activos.
SIGA_GOOGLE_LOGIN=false
SIGA_MICROSOFT_LOGIN=false
SIGA_APPLE_LOGIN=false
SIGA_AUTH_REDIRECT=ao.portalsiga.sigaplus://login-callback
