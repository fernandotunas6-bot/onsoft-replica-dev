{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview:prod",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 180000,
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/alunos",
        "http://127.0.0.1:3000/pedagogica",
        "http://127.0.0.1:3000/pessoas",
        "http://127.0.0.1:3000/importar",
        "http://127.0.0.1:3000/documentos",
        "http://127.0.0.1:3000/faturas"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "first-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "interactive": ["error", { "maxNumericValue": 3500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "max-potential-fid": ["error", { "maxNumericValue": 300 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "viewport": "error",
        "color-contrast": "error",
        "target-size": "warn",
        "aria-allowed-attr": "error",
        "aria-required-attr": "error",
        "aria-valid-attr-value": "error",
        "button-name": "error",
        "link-name": "error",
        "image-alt": "error",
        "label": "error",
        "uses-responsive-images": "warn",
        "unused-javascript": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "reports/lighthouse"
    }
  }
}
