<!DOCTYPE html>
<html lang="pt-AO">
<head>
  <meta charset="UTF-8" />
  <style>{{{css}}}</style>
</head>
<body>
  <main class="document document-declaracao">
    <section class="official-topline angola-official">
      {{#if school.emblemUrl}}
      <img class="logo emblem" src="{{school.emblemUrl}}" alt="Emblema de Angola" />
      {{else}}
      <img class="logo" src="{{school.logoUrl}}" alt="" />
      {{/if}}
      <div class="school-title">
        <p class="republic">{{school.ministry}}</p>
        <p class="republic">{{school.ministryLine}}</p>
        <h1>{{school.name}}</h1>
        <p>{{school.address}} | NIF {{school.nif}}</p>
      </div>
      <div class="official-right">
        {{#if school.logoUrl}}
        <img class="logo school-mark" src="{{school.logoUrl}}" alt="Logotipo da escola" />
        {{else}}
        {{#if school.flagUrl}}
        <img class="logo flag" src="{{school.flagUrl}}" alt="Bandeira de Angola" />
        {{/if}}
        {{/if}}
        <div class="document-box">Nº {{document.number}}</div>
      </div>
    </section>

    <div class="doc-title">Declaração Simples de Notas</div>

    <p class="statement-text">
      Declara-se, para os devidos efeitos, que o estudante
      <b>{{student.fullName}}</b>, processo académico nº
      <b>{{student.academicNumber}}</b>, documento {{student.docType}}
      <b>{{student.docNumber}}</b>, encontra-se registado nesta instituição e
      obteve as classificações abaixo indicadas no contexto do sistema
      nacional de ensino em Angola.
    </p>

    <section class="meta-grid">
      <div class="meta-box"><b>Classe/Curso:</b> {{program.name}}</div>
      <div class="meta-box"><b>Turma:</b> {{classGroup.name}}</div>
      <div class="meta-box"><b>Ano lectivo:</b> {{academicYear.name}}</div>
      <div class="meta-box"><b>Período:</b> {{period.name}}</div>
      <div class="meta-box"><b>Escala:</b> {{angola.gradingScale}}</div>
      <div class="meta-box"><b>Nota mínima:</b> {{angola.minimumPass}}</div>
    </section>

    <table>
      <thead>
        <tr>
          <th class="text-left">Disciplina</th>
          <th>Período</th>
          <th>Nota Final</th>
          <th>Situação</th>
        </tr>
      </thead>
      <tbody>
        {{#each grades}}
        <tr>
          <td class="text-left">{{fallback name subject}}</td>
          <td>{{fallback periodName period}}</td>
          <td><b>{{fallback finalGrade grade}}</b></td>
          <td data-status="{{status}}">{{status}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <section class="summary-panel">
      <div><span>Média</span><strong>{{summary.average}}</strong></div>
      <div><span>Aprovadas</span><strong>{{summary.approved}}</strong></div>
      <div><span>Reprovações</span><strong>{{summary.failed}}</strong></div>
      <div><span>Resultado</span><strong>{{summary.status}}</strong></div>
    </section>

    <section class="footer">
      {{#each signatures}}
      <div class="signature">{{label}}</div>
      {{/each}}
    </section>

    <section class="validation">
      {{#if document.qrCodeDataUrl}}<img class="qr" src="{{document.qrCodeDataUrl}}" />{{/if}}
      <div>
        Esta declaração é derivada do Histórico Académico Individual e não substitui a pauta nem o histórico permanente.<br />
        Documento nº {{document.number}} | Hash {{document.hash}} | Emitido em {{document.issuedAtLabel}} por {{document.issuedBy}}.
      </div>
    </section>
  </main>
</body>
</html>
