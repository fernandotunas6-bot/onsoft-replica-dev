{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIGA Desktop",
  "version": "1.0.0",
  "identifier": "ao.onsoft.siga",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3006",
    "beforeBuildCommand": "node scripts/check-desktop.mjs",
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "title": "SIGA - Sistema Integrado de Gest\u00e3o Acad\u00e9mica",
        "width": 1280,
        "height": 832,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "transparent": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src https://portal-siga.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
