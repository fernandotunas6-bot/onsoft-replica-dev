{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIGA Desktop",
  "version": "1.0.0",
  "identifier": "ao.onsoft.siga",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3006",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "SIGA Desktop"
    },
    "windows": [
      {
        "title": "SIGA - Sistema Integrado de Gestão Académica",
        "width": 1280,
        "height": 832,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
