{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "school-portal",
  "description": "Native school functions for the exact trusted SIGA portal",
  "local": false,
  "remote": {
    "urls": ["https://portal-siga.com/*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
    "allow-get-system-info",
    "allow-hardware-bridge-request",
    "allow-open-external-url",
    "allow-pulse-turnstile-relay",
    "allow-print-thermal-receipt-native",
    "allow-save-file",
    "allow-print-page",
    "allow-print-html",
    "allow-open-payflow",
    "allow-check-app-update",
    "allow-install-app-update",
    "notification:default"
  ]
}
