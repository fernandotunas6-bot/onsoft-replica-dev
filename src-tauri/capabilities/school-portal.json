{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "school-portal",
  "description": "Native school functions for the exact trusted SIGA portal",
  "local": false,
  "remote": {
    "urls": [
      "https://portal-siga.com/*"
    ]
  },
  "windows": [
    "school"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "allow-get-system-info",
    "allow-hardware-bridge-request",
    "allow-open-external-url",
    "allow-pulse-turnstile-relay",
    "allow-print-thermal-receipt-native",
    "allow-save-file",
    "allow-print-page",
    "allow-print-html",
    "allow-open-payflow",
    "allow-check-app-update",
    "allow-install-app-update",
    "allow-portal-store-get",
    "allow-portal-store-set",
    "allow-portal-store-delete",
    "allow-portal-vault-unlock",
    "allow-portal-vault-lock",
    "allow-portal-vault-get",
    "allow-portal-vault-set",
    "allow-portal-vault-remove",
    "notification:default"
  ]
}
