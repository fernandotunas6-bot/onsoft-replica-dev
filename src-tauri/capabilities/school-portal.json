{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "school-portal",
  "description": "Native school functions for the exact trusted SIGA portal",
  "local": false,
  "remote": {
    "urls": ["https://portal-siga.com/*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-get-system-info",
    "allow-open-external-url",
    "allow-pulse-turnstile-relay",
    "allow-print-thermal-receipt-native",
    "notification:default"
  ]
}
