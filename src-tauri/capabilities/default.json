{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for SIGA Desktop",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": ["https://portal-siga.com/*", "https://*.portal-siga.com/*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:webview:allow-set-webview-zoom",
    "store:default",
    "window-state:default",
    "stronghold:default",
    "notification:default",
    "updater:default",
    "process:default",
    "allow-get-system-info",
    "allow-pulse-turnstile-relay",
    "allow-print-thermal-receipt-native",
    "allow-save-file",
    "allow-print-page",
    "allow-print-html"
  ]
}
