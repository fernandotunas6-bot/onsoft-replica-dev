# Produção é o modo seguro por omissão. Sandbox requer ativação explícita local.
PAYFLOW_RUNTIME_MODE=production
PAYFLOW_INTEGRATION_API_KEY=
PAYFLOW_SSO_SECRET=
PAYFLOW_SIGA_URL=http://localhost:3006
NEXT_PUBLIC_SIGA_URL=http://localhost:3006
PAYFLOW_TRANSFER_EXPIRY_HOURS=72

# Alertas externos (Sentry/pager/Slack). Sem URL HTTPS = só logs JSON.
# PAYFLOW_ALERT_WEBHOOK_URL=https://example.com/payflow-alerts

# Conector bancário (URL fixa no servidor; a rota /pull nunca aceita URL do pedido).
# PAYFLOW_BANK_CONNECTOR_URL=https://banco.example/movements
# PAYFLOW_BANK_CONNECTOR_KEY=
# Sandbox local (só com PAYFLOW_RUNTIME_MODE=sandbox):
# PAYFLOW_BANK_CONNECTOR_URL=http://localhost:3007/api/v1/bank-movements/sandbox-feed?transfer_reference=PF-TF-20260905-ABC123DEAD&amount=1500000
# PAYFLOW_BANK_CONNECTOR_KEY=local-bank-connector-key

# Credenciais reais são fornecidas apenas após contratação e homologação.
# PAYFLOW_EMIS_HOMOLOGATED=1 só depois do contrato EMIS — o adaptador de produção ainda recusa.
EMIS_BASE_URL=
EMIS_MERCHANT_ID=
EMIS_TERMINAL_ID=
EMIS_API_KEY=
EMIS_WEBHOOK_SECRET=
