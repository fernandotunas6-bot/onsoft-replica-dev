# Domínio e nome institucional da plataforma — único ponto de configuração.
# Para mudar de domínio futuramente: alterar só aqui (sem alterar código da aplicação).
APP_URL=https://portal-siga.com
APP_NAME=SIGA Plus
VITE_APP_URL=https://portal-siga.com
VITE_APP_NAME=SIGA Plus

# Public browser configuration. Never place sb_secret_ or service_role keys here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Ecossistema — URLs públicas das 5 apps (sem hardcode de produção).
# VITE_WEB_URL=http://localhost:5174
# VITE_SIGA_URL=http://localhost:3006
# VITE_PAYFLOW_URL=http://localhost:3007
# VITE_ADMIN_URL=http://localhost:3005
# VITE_DOCS_URL=http://localhost:5173
#
# Superfícies demo do kit (mail/chat/dashboard…). Por defeito OFF —
# rotas mortas redireccionam para destinos vivos (alive-bridges).
# VITE_SHOW_TEMPLATE_SURFACES=true          # WEB: painel/web
# NEXT_PUBLIC_SHOW_TEMPLATE_SURFACES=true  # ADMIN: painel/admin
# NEXT_PUBLIC_WEB_URL / NEXT_PUBLIC_SIGA_URL / NEXT_PUBLIC_PAYFLOW_URL / NEXT_PUBLIC_ADMIN_URL / NEXT_PUBLIC_DOCS_URL
#   → também no painel/admin/.env.local (npm run siga:sync-env)
#
# PayFlow — valores apenas do servidor; nunca usar prefixo VITE_ ou NEXT_PUBLIC_ para a chave.
PAYFLOW_RUNTIME_MODE=production
PAYFLOW_INTEGRATION_API_KEY=
PAYFLOW_SSO_SECRET=
PAYFLOW_SIGA_URL=http://localhost:3006
PAYFLOW_TRANSFER_EXPIRY_HOURS=72
# Sandbox requer PAYFLOW_RUNTIME_MODE=sandbox explícito e destina-se apenas ao desenvolvimento local.
#
# Firebase Analytics — off no núcleo; só se precisar de telemetria híbrida:
# VITE_FIREBASE_ANALYTICS=true

# Temporary: skip login UI and auto-open a demo admin session (local only).
# VITE_AUTH_DISABLED=true

# Server-side user-scoped client configuration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Configure SUPABASE_SECRET_KEY only in the protected deployment environment.
# Required for /acessos invite + account management (never expose via VITE_*).
# SUPABASE_SECRET_KEY=sb_secret_your_server_key
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...legacy_service_role_jwt
# Must match VITE_AUTH_DISABLED for the temporary login bypass.
# AUTH_BYPASS=true

# --- E2E ecossistema (local / CI) ---
# SIGA_E2E_CI=1          # smoke tolera 500 nas APIs sem Supabase
# SIGA_E2E_LIVE=1        # Playwright cria tenant real (requer secret abaixo)
# SIGA_E2E_SKIP_UI=1     # omitir Playwright UI (ex.: macOS 12)
# SIGA_E2E_WAIT_ATTEMPTS=120
# npm run siga:e2e-playwright-ts       # rotas + wizard (sem Supabase)
# npm run siga:e2e-playwright-live     # comercial + matrícula @live
# npm run siga:e2e-live-only            # pipeline @live (ecossistema já a correr)
#
# Webhook Multicaixa (dev/simulador EMIS — opcional):
# SIGA_GATEWAY_DEV_API_KEY=e2e-gateway-dev-key-ci
#   → prepare-ci-env.mjs injecta a mesma chave na CI @live
#
# Alertas webhook gateway (opcional — Slack Incoming Webhook em falhas HTTP ≥ 400):
# SIGA_GATEWAY_ALERT_SLACK_URL=https://hooks.slack.com/services/…
#
# Alerta de plataforma quando taxa de falha 24h excede limiar (Slack e/ou Resend):
# SIGA_GATEWAY_FAILURE_RATE_ALERT_SLACK_URL=https://hooks.slack.com/services/…
# SIGA_GATEWAY_FAILURE_RATE_ALERT_EMAIL_TO=ops@siga.ao
# SIGA_GATEWAY_FAILURE_RATE_THRESHOLD=0.25
# SIGA_GATEWAY_FAILURE_RATE_MIN_EVENTS=5
# SIGA_GATEWAY_FAILURE_RATE_COOLDOWN_HOURS=6
# Cron sugerido: npm run siga:gateway-failure-rate-check (horário, ex. de hora a hora)
#
# CI @live: secrets GitHub SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY
# Alertas E2E (opcional): SLACK_E2E_WEBHOOK_URL — Slack Incoming Webhook
#   ou RESEND_API_KEY + E2E_ALERT_EMAIL_TO (+ E2E_ALERT_EMAIL_FROM opcional)
# Resend escolar: API key em Definições → Integrações (merchant) ou RESEND_API_KEY no servidor
# WhatsApp Cloud API: Phone Number ID (merchant) + token no callback (não-URL) ou WHATSAPP_ACCESS_TOKEN
# → node scripts/siga/prepare-ci-env.mjs antes de arrancar o ecossistema
