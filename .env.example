# Public browser configuration. Never place sb_secret_ or service_role keys here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Temporary: skip login UI and auto-open a demo admin session (local only).
# VITE_AUTH_DISABLED=true

# Server-side user-scoped client configuration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Configure SUPABASE_SECRET_KEY only in the protected deployment environment.
# Required for /acessos invite + account management (never expose via VITE_*).
# SUPABASE_SECRET_KEY=sb_secret_your_server_key
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...legacy_service_role_jwt
# Must match VITE_AUTH_DISABLED for the temporary login bypass.
# AUTH_BYPASS=true
