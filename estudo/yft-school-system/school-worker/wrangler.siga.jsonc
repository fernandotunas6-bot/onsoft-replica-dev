// Publicação na conta Cloudflare do SIGA (ver ../PUBLICAR_SIGA.md).
// Um só Worker serve a app Flutter (assets) e a API (/api, /media, /health),
// na mesma origem: não precisa de CORS. Base D1 e bucket R2 próprios, vazios
// à partida, separados da base do autor e do Supabase do SIGA.
// O script ../scripts/publicar-siga.sh substitui __D1_DATABASE_ID__.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siga-yft",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../build/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/health"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "siga-yft-db",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "siga-yft-media" }],
  "vars": {
    // Público: o mesmo id que `flutterfire configure --project=...` usa.
    "FIREBASE_PROJECT_ID": "siga-plus-integracoes",
    // Supabase do SIGA (público, igual a src/integrations/supabase/client.ts):
    // a API /api/sga valida aqui as sessões. A chave de servidor é segredo:
    // SGA_SUPABASE_SECRET_KEY, gravada pelo script (nunca neste ficheiro).
    "SGA_SUPABASE_URL": "https://xodgfmxiaunpamctfeea.supabase.co",
    "SGA_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_NSqtGz5zxP_EngLuNj00Og_y3V4D4td",
  },
  // Segredos (nunca aqui): FIREBASE_WEB_API_KEY, SUPER_ADMIN_API_KEY e,
  // opcional, FIREBASE_SERVICE_ACCOUNT_JSON. O script grava-os com
  // `wrangler secret bulk`.
  //
  // O domínio m.portal-siga.com NÃO está aqui de propósito: hoje pertence ao
  // Worker siga-plus-mobile-v4-domain. A troca é um passo à parte, com
  // reversão (PUBLICAR_SIGA.md, passo 4); o env "dominio" abaixo é o usado.
  "env": {
    "dominio": {
      "name": "siga-yft",
      "workers_dev": false,
      // A rota específica é precisa porque o portal tem uma rota wildcard na
      // mesma zona (igual à configuração actual do Mobile V4).
      "routes": [
        { "pattern": "m.portal-siga.com", "custom_domain": true },
        { "pattern": "m.portal-siga.com/*", "zone_name": "portal-siga.com" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "siga-yft-db",
          "database_id": "__D1_DATABASE_ID__",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "siga-yft-media" }],
      "vars": {
        "FIREBASE_PROJECT_ID": "siga-plus-integracoes",
        "SGA_SUPABASE_URL": "https://xodgfmxiaunpamctfeea.supabase.co",
        "SGA_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_NSqtGz5zxP_EngLuNj00Og_y3V4D4td",
      },
    },
  },
}
